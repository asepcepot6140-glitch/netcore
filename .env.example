WEB_PORT=80

# DB_HOST, DB_PORT, dan DB_SSLMODE diatur otomatis oleh docker-compose.yml
DB_USER=netcore
DB_PASSWORD=ganti-dengan-password-kuat
DB_NAME=netcore

# Minimal 32 karakter. Buat dengan: openssl rand -hex 32
JWT_SECRET=

WHATSAPP_GATEWAY_URL=
WHATSAPP_GATEWAY_USERNAME=
WHATSAPP_GATEWAY_PASSWORD=

# Opsional: IP/CIDR router yang diblokir bawaan (mis. di belakang CGNAT), pisahkan dengan koma
# TARGET_ALLOWLIST=100.64.0.0/10
